{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "tag-agency-landing-page",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tag-agency-landing-page"
    }
  ],
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "tag-agency-leads",
      "database_id": "67f2d498-f402-4ed5-86ec-74767dd06278",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "73480653",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
